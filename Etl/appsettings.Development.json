{
  "ConnectionStrings": {
    "RentWiseProDb": "__SET_VIA_ENV_OR_LOCAL_SECRET__"
  },
  "Etl": {
    "MarkOffMarketAfterMissingRuns": 3,
    "MaxPhotosPerProperty": 10,
    "UseFixtures": true,
    "FixtureScenario": "baseline",
    "FixtureSources": [
      "Fixture Listings"
    ],
    "FixtureRootPath": "../Etl.Sources/Fixtures"
  },
  "Storage": {
    "RawPayloadPath": ".local/raw",
    "PhotoStoragePath": ".local/photos"
  },
  "RapidApi": {
    "ApiKey": "__SET_VIA_ENV_OR_USER_SECRETS__",
    "Sources": [
      {
        "Name": "US Real Estate Listings",
        "Host": "us-real-estate-listings.p.rapidapi.com",
        "BaseUrl": "https://us-real-estate-listings.p.rapidapi.com",
        "EndpointTemplate": "/v2/properties?offset={page}&limit={pageSize}",
        "MaxRequestsPerMinute": 60,
        "MaxConcurrency": 2,
        "PageSize": 50
      }
    ]
  },
  "EtlExecution": {
    "Interval": "12:00:00"
  }
}
