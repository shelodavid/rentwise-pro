@{
    ViewData["Title"] = "RentWise Pro";
    Layout = "_MarketingLayout";
}

<section class="marketing-hero">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <span class="badge-soft">Investment-ready rental analysis</span>
                <h1 class="display-5 fw-bold mt-3">RentWise Pro</h1>
                <p class="lead text-muted">
                    Build confidence in every rental acquisition with clear purchase costs, ROI forecasting,
                    and saved analysis workflows.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Log in</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="marketing-hero-card">
                    <div class="hero-card-header">Live Portfolio Snapshot</div>
                    <div class="hero-card-body">
                        <div class="hero-metric">
                            <div class="label">Projected ROI (Year 1)</div>
                            <div class="value">12.4%</div>
                        </div>
                        <div class="hero-metric">
                            <div class="label">Cash to Close</div>
                            <div class="value">$48,200</div>
                        </div>
                        <div class="hero-metric">
                            <div class="label">Monthly Cash Flow</div>
                            <div class="value">$620</div>
                        </div>
                    </div>
                    <div class="hero-card-footer">
                        Backed by your Investment Profile assumptions.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="marketing-section">
    <div class="container">
        <div class="section-header">
            <h2>Everything you need to underwrite rentals fast</h2>
            <p class="text-muted">Analyze deal costs, returns, and long-term performance with one workflow.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card feature-tile">
                    <div class="card-body">
                        <h5>Purchase Sheet</h5>
                        <p class="text-muted mb-0">Estimate total cash-to-close with transparent closing cost inputs.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-tile">
                    <div class="card-body">
                        <h5>ROI Forecast</h5>
                        <p class="text-muted mb-0">Model monthly and long-term returns across 6 months to 5 years.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-tile">
                    <div class="card-body">
                        <h5>Saved Analyses</h5>
                        <p class="text-muted mb-0">Track every property you evaluate with reusable assumptions.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="marketing-section bg-light">
    <div class="container">
        <div class="section-header">
            <h2>How it works</h2>
            <p class="text-muted">From listing to forecast in three guided steps.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h6>Find a listing</h6>
                    <p class="text-muted mb-0">Browse imported rental listings with price and rent estimates.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h6>Save assumptions</h6>
                    <p class="text-muted mb-0">Apply your down payment, interest, and expense profiles.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h6>Forecast returns</h6>
                    <p class="text-muted mb-0">Review ROI projections and cash flow at a glance.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="marketing-footer">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span class="text-muted">&copy; 2026 RentWise Pro</span>
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
