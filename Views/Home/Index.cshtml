@model RentWisePro.Web.Models.HomeIndexVm
@{
    ViewData["Title"] = "Home Page";
    ViewData["PageTitle"] = "Saved Properties";
    ViewData["PageSubtitle"] = "Select a listing to start a new analysis.";
}

@await Html.PartialAsync("_PageHeader", (
    ViewData["PageTitle"] as string ?? ViewData["Title"] as string ?? string.Empty,
    ViewData["PageSubtitle"] as string,
    ViewData["PageMeta"] as string))

@{
    var statusMessage = TempData["StatusMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-warning" role="alert">
        @statusMessage
    </div>
}

@if (Model.Listings.Count == 0)
{
    <div class="alert alert-info">
        No listings are available yet. Import listings to start generating purchase sheets.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var listing in Model.Listings)
        {
            <div class="col-xl-4 col-lg-6">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(listing.ImgSrc))
                    {
                        <img src="@listing.ImgSrc" class="card-img-top" alt="Listing image" />
                    }
                    <div class="card-body d-flex flex-column gap-3">
                        <div>
                            <h5 class="mb-1">@listing.StreetAddress</h5>
                            <p class="text-muted mb-0">@listing.City, @listing.State @listing.ZipCode</p>
                        </div>
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="text-muted small">Price</div>
                                <div class="fw-semibold">@(listing.Price.HasValue ? listing.Price.Value.ToString("C0") : "-")</div>
                            </div>
                            <div>
                                <div class="text-muted small">Beds/Baths</div>
                                <div class="fw-semibold">@(listing.Bedrooms?.ToString() ?? "-") / @(listing.Bathrooms?.ToString("0.0") ?? "-")</div>
                            </div>
                        </div>
                        <div class="mt-auto d-flex flex-column gap-2">
                            <form asp-controller="SavedProperties" asp-action="StartAnalysis" method="post" class="d-grid">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="zpid" value="@listing.Zpid" />
                                <button type="submit" class="btn btn-primary">Start Analysis</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
