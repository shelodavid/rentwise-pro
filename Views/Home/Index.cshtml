@model RentWisePro.Web.Models.HomeIndexVm
@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="display-5 mb-1">Rental Listings</h1>
        <p class="text-muted mb-0">Select a listing to generate a purchase sheet.</p>
    </div>
</div>

@if (Model.Listings.Count == 0)
{
    <div class="alert alert-info">
        No listings are available yet. Import listings to start generating purchase sheets.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var listing in Model.Listings)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(listing.ImgSrc))
                    {
                        <img src="@listing.ImgSrc" class="card-img-top" alt="Listing image" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">@listing.StreetAddress</h5>
                        <p class="text-muted mb-2">@listing.City, @listing.State @listing.ZipCode</p>
                        <div class="mb-3">
                            <div><strong>Price:</strong> @(listing.Price.HasValue ? listing.Price.Value.ToString("C") : "-")</div>
                            <div><strong>Beds/Baths:</strong> @(listing.Bedrooms?.ToString() ?? "-") / @(listing.Bathrooms?.ToString("0.0") ?? "-")</div>
                        </div>
                        <a class="btn btn-primary mt-auto"
                           asp-controller="Home"
                           asp-action="GeneratePurchaseSheet"
                           asp-route-zpid="@listing.Zpid">
                            Generate Purchase Sheet
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
