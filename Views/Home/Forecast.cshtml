@model RentWisePro.Web.Models.Forecast.ForecastPageVm

@{
    ViewData["Title"] = "ROI Forecast";
    ViewData["PageTitle"] = "ROI Forecast";
    ViewData["PageSubtitle"] = "Use the forecast to validate monthly returns and long-term ROI.";
    ViewData["PageMeta"] = $"ZPID {Model.Listing.Zpid}";
    ViewData["CurrentSavedPropertyProfileId"] = Model.SavedPropertyProfileId;
}

@await Html.PartialAsync("_PageHeader")

@await Html.PartialAsync("_KpiRibbon", Model.Kpis)

<div class="row g-3 mb-4">
    <div class="col-md-4">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData)
        {
            ["StatLabel"] = "Loan Amount",
            ["StatValue"] = Model.Assumptions.LoanAmount.ToString("C0"),
            ["StatHelper"] = "Based on current terms"
        })
    </div>
    <div class="col-md-4">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData)
        {
            ["StatLabel"] = "Monthly Mortgage",
            ["StatValue"] = Model.Assumptions.MonthlyMortgage.ToString("C0"),
            ["StatHelper"] = "Principal + interest"
        })
    </div>
    <div class="col-md-4">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData)
        {
            ["StatLabel"] = "Cash Required",
            ["StatValue"] = Model.Assumptions.TotalCashInvested.ToString("C0"),
            ["StatHelper"] = "Down payment + closing"
        })
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="card mb-4">
            <div class="card-body">
                <div class="text-muted text-uppercase small">Property Snapshot</div>
                <h4 class="mt-2 mb-1">@Model.Listing.AddressLine</h4>
                <p class="text-muted mb-3">@Model.Listing.LocationLine</p>
                @if (!string.IsNullOrWhiteSpace(Model.Listing.ImgSrc))
                {
                    <img src="@Model.Listing.ImgSrc" alt="Listing image" class="img-fluid rounded" />
                }
                <div class="mt-3">
                    <span class="badge bg-light text-dark border">@Model.Listing.PropertyType</span>
                    @if (Model.Listing.Bedrooms.HasValue || Model.Listing.Bathrooms.HasValue)
                    {
                        <span class="badge bg-light text-dark border">@Model.Listing.Bedrooms bd · @Model.Listing.Bathrooms ba</span>
                    }
                </div>
            </div>
        </div>

        <form class="card" aria-label="Forecast inputs">
            <div class="card-header">Inputs</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="priceInput">Purchase Price</label>
                    <input id="priceInput" class="form-control" value="@Model.Listing.Price.ToString("C0")" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="downPaymentInput">Down Payment %</label>
                    <input id="downPaymentInput" class="form-control" value="@Model.Assumptions.DownpaymentPercentage.ToString("0.0")%" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rateInput">Interest Rate</label>
                    <input id="rateInput" class="form-control" value="@Model.Assumptions.MortgageInterestRate.ToString("0.00")%" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rentInput">Monthly Rent</label>
                    <input id="rentInput" class="form-control" value="@Model.Assumptions.MonthlyRent.ToString("C0")" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="expenseInput">Total Monthly Expenses</label>
                    <input id="expenseInput" class="form-control" value="@Model.Assumptions.TotalMonthlyExpenses.ToString("C0")" readonly />
                </div>
                <div class="mb-0">
                    <label class="form-label" for="cashInput">Total Cash Invested</label>
                    <input id="cashInput" class="form-control" value="@Model.Assumptions.TotalCashInvested.ToString("C0")" readonly />
                </div>
            </div>
        </form>
    </div>
    <div class="col-xl-8">
        <div class="card mb-4">
            <div class="card-header">Cash Flow Forecast</div>
            <div class="card-body">
                <canvas id="cashFlowChart" height="120" aria-label="Cash flow forecast chart" role="img"></canvas>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">ROI Mix</div>
                    <div class="card-body">
                        <canvas id="roiMixChart" height="180" aria-label="ROI mix chart" role="img"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Assumption Summary</div>
                    <div class="card-body">
                        <table class="table-lite">
                            <tr>
                                <td>Loan Amount</td>
                                <td>@Model.Assumptions.LoanAmount.ToString("C0")</td>
                            </tr>
                            <tr>
                                <td>Monthly Mortgage</td>
                                <td>@Model.Assumptions.MonthlyMortgage.ToString("C0")</td>
                            </tr>
                            <tr>
                                <td>Monthly Non-Mortgage</td>
                                <td>@Model.Assumptions.MonthlyNonMortgageExpenses.ToString("C0")</td>
                            </tr>
                            <tr>
                                <td>Annual NOI</td>
                                <td>@((Model.Assumptions.MonthlyRent - Model.Assumptions.MonthlyNonMortgageExpenses) * 12m).ToString("C0")</td>
                            </tr>
                            <tr>
                                <td>Annual Debt Service</td>
                                <td>@((Model.Assumptions.MonthlyMortgage + Model.Assumptions.MonthlyPmi) * 12m).ToString("C0")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" integrity="sha256-7sZrVYoF0zTDy2A+/vQc84d3ufcGk3wZp+XwsaNq8qQ=" crossorigin="anonymous"></script>
    <script>
        const cashFlowCtx = document.getElementById('cashFlowChart');
        if (cashFlowCtx) {
            new Chart(cashFlowCtx, {
                type: 'line',
                data: {
                    labels: ['Month 1', 'Month 2', 'Month 3', 'Month 4', 'Month 5', 'Month 6'],
                    datasets: [{
                        label: 'Net Cash Flow',
                        data: [@Model.Kpis.MonthlyCashflow, @Model.Kpis.MonthlyCashflow + 125, @Model.Kpis.MonthlyCashflow + 190, @Model.Kpis.MonthlyCashflow + 210, @Model.Kpis.MonthlyCashflow + 240, @Model.Kpis.MonthlyCashflow + 300],
                        borderColor: '#1d4ed8',
                        backgroundColor: 'rgba(29, 78, 216, 0.2)',
                        tension: 0.35,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: (value) => `$${value}`
                            }
                        }
                    }
                }
            });
        }

        const roiMixCtx = document.getElementById('roiMixChart');
        if (roiMixCtx) {
            new Chart(roiMixCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Cash Flow', 'Appreciation', 'Debt Paydown', 'Tax Benefits'],
                    datasets: [{
                        data: [45, 25, 20, 10],
                        backgroundColor: ['#1d4ed8', '#38bdf8', '#a5b4fc', '#0f766e']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    </script>
}
