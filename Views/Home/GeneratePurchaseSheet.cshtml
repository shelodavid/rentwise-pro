@model RentWisePro.Web.Models.PurchaseSheetPageVm
@{
    ViewData["Title"] = "Purchase Sheet";
    ViewData["PageTitle"] = "Purchase Sheet";
    ViewData["PageSubtitle"] = "Review financing assumptions and upfront costs before committing capital.";
    ViewData["CurrentSavedPropertyProfileId"] = Model.SavedPropertyProfileId;
}

@await Html.PartialAsync("_PageHeader", (
    ViewData["PageTitle"] as string ?? ViewData["Title"] as string ?? string.Empty,
    ViewData["PageSubtitle"] as string,
    ViewData["PageMeta"] as string))

<div class="row g-4" data-stepper data-active-step="0">
    <div class="col-xl-4">
        <div class="card h-100">
            @if (!string.IsNullOrWhiteSpace(Model.ImgSrc))
            {
                <img src="@Model.ImgSrc" class="card-img-top" alt="Listing image" />
            }
            <div class="card-body">
                <h4 class="card-title mb-1">@Model.StreetAddress</h4>
                <p class="text-muted">@Model.City, @Model.State @Model.ZipCode</p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-muted small">Price</div>
                        <div class="fw-semibold">@(Model.Price.HasValue ? Model.Price.Value.ToString("C0") : "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Estimated Rent</div>
                        <div class="fw-semibold">@(Model.EstimatedRent.HasValue ? Model.EstimatedRent.Value.ToString("C0") : "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Type</div>
                        <div class="fw-semibold">@Model.PropertyType</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Beds/Baths</div>
                        <div class="fw-semibold">@(Model.Bedrooms?.ToString() ?? "-") / @(Model.Bathrooms?.ToString("0.0") ?? "-")</div>
                    </div>
                </div>
                <div class="mt-4">
                    <a class="btn btn-outline-secondary w-100" asp-controller="Home" asp-action="Index">Back to Listings</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <form asp-action="GeneratePurchaseSheet" method="post" class="card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SavedPropertyProfileId" />
            <input type="hidden" asp-for="Zpid" />
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                @await Html.PartialAsync("_StepIndicator", new[] { "Financing", "Upfront Costs", "Review" }, new ViewDataDictionary(ViewData) { ["ActiveStep"] = 0 })

                <section class="step-panel is-active" data-step-panel="0" aria-hidden="false">
                    <div class="mb-4">
                        <h5 class="mb-1">Financing Assumptions</h5>
                        <p class="text-muted">Tune the financing terms that impact cash-to-close.</p>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="DownpaymentPercentage" class="form-label"></label>
                            <input asp-for="DownpaymentPercentage" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="DownpaymentPercentage" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MortgageInterestRate" class="form-label"></label>
                            <input asp-for="MortgageInterestRate" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="MortgageInterestRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TermYears" class="form-label"></label>
                            <input asp-for="TermYears" class="form-control" type="number" />
                            <span asp-validation-for="TermYears" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-primary" data-step-next>Continue to Costs</button>
                    </div>
                </section>

                <section class="step-panel" data-step-panel="1" aria-hidden="true">
                    <div class="mb-4">
                        <h5 class="mb-1">Upfront Costs</h5>
                        <p class="text-muted">Set one-time costs for closing and renovations.</p>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="ClosingCostOverride" class="form-label"></label>
                            <input asp-for="ClosingCostOverride" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="ClosingCostOverride" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RenovationBudget" class="form-label"></label>
                            <input asp-for="RenovationBudget" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="RenovationBudget" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OtherUpfrontCosts" class="form-label"></label>
                            <input asp-for="OtherUpfrontCosts" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="OtherUpfrontCosts" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-step-prev>Back</button>
                        <button type="button" class="btn btn-primary" data-step-next>Review Outputs</button>
                    </div>
                </section>

                <section class="step-panel" data-step-panel="2" aria-hidden="true">
                    <div class="mb-4">
                        <h5 class="mb-1">Review &amp; Submit</h5>
                        <p class="text-muted">Confirm total cash requirements and cost breakdown.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="card card-muted h-100">
                                <div class="card-body">
                                    <h6 class="fw-semibold">Computed Outputs</h6>
                                    <table class="table-lite">
                                        <tr>
                                            <td>Downpayment Amount</td>
                                            <td>@Model.Outputs.DownpaymentAmount.ToString("C")</td>
                                        </tr>
                                        <tr>
                                            <td>Mortgage Amount</td>
                                            <td>@Model.Outputs.MortgageAmount.ToString("C")</td>
                                        </tr>
                                        <tr>
                                            <td>Monthly P&amp;I</td>
                                            <td>@Model.Outputs.MonthlyPrincipalAndInterest.ToString("C")</td>
                                        </tr>
                                        <tr>
                                            <td>Closing Costs (Calculated)</td>
                                            <td>@Model.Outputs.CalculatedClosingCosts.ToString("C")</td>
                                        </tr>
                                        <tr>
                                            <td>Total Closing Costs Used</td>
                                            <td>@Model.Outputs.TotalClosingCosts.ToString("C")</td>
                                        </tr>
                                        <tr>
                                            <td>Total Cash to Close</td>
                                            <td>@Model.Outputs.CashToClose.ToString("C")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card card-muted h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h6 class="fw-semibold mb-0">Closing Cost Breakdown</h6>
                                        <button class="collapse-toggle" type="button" data-collapse-target="closingCostBreakdown" aria-expanded="false">
                                            Toggle
                                        </button>
                                    </div>
                                    <div id="closingCostBreakdown" class="collapse-panel mt-3" aria-live="polite">
                                        <table class="table-lite">
                                            <tr>
                                                <td>Base Closing Costs</td>
                                                <td>@Model.ClosingCosts.ClosingCostsPercentage.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Realtor Fees</td>
                                                <td>@Model.ClosingCosts.RealtorFees.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Loan Origination</td>
                                                <td>@Model.ClosingCosts.LoanOriginationFee.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Appraisal</td>
                                                <td>@Model.ClosingCosts.AppraisalFee.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Credit Report</td>
                                                <td>@Model.ClosingCosts.CreditReportFee.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Title Insurance</td>
                                                <td>@Model.ClosingCosts.TitleInsurance.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Title Search</td>
                                                <td>@Model.ClosingCosts.TitleSearch.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Escrow Fee</td>
                                                <td>@Model.ClosingCosts.EscrowFee.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Flood Inspection</td>
                                                <td>@Model.ClosingCosts.FloodInspectionFee.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>Miscellaneous Fees</td>
                                                <td>@Model.ClosingCosts.MiscellaneousFees.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td>HOA Estimate</td>
                                                <td>@Model.ClosingCosts.HoaEstimate.ToString("C")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-step-prev>Back</button>
                        <button type="submit" class="btn btn-primary btn-lg">Update Purchase Sheet</button>
                    </div>
                </section>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
