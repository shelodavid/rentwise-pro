@model RentWisePro.Web.Models.EtlOpsViewModel

@{
    ViewData["Title"] = "ETL Ops";
    var message = TempData["EtlOpsMessage"] as string;
    var success = TempData["EtlOpsSuccess"] as bool?;
    var scheduleLabel = Model.RunnerStatus.ScheduleEnabled switch
    {
        true => "Enabled",
        false => "Disabled",
        null => "Unknown"
    };
    var scheduleBadge = Model.RunnerStatus.ScheduleEnabled switch
    {
        true => "bg-success",
        false => "bg-danger",
        null => "bg-secondary"
    };
}

<h1 class="mb-4">ETL Operations</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(success == true ? "alert-success" : "alert-danger")" role="alert">
        @message
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Runner Status</h5>
                <p class="card-text">@Model.RunnerStatus.StatusMessage</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Schedule Status</h5>
                <span class="badge @scheduleBadge">@scheduleLabel</span>
                @if (!string.IsNullOrWhiteSpace(Model.RunnerStatus.ScheduleStatusMessage))
                {
                    <p class="card-text mt-2">@Model.RunnerStatus.ScheduleStatusMessage</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-3 mb-4">
    <form asp-action="RunIngestionOnce" method="post">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmIngestionModal">
            Run ETL (once)
        </button>
        <div class="modal fade" id="confirmIngestionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm ETL Run</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        This will start the ETL ingestion process one time. Continue?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Start ETL</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <form asp-action="RunQueueOnce" method="post">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#confirmQueueModal">
            Run Queue (once)
        </button>
        <div class="modal fade" id="confirmQueueModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Queue Processing</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        This will process the work queue one time. Continue?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Start Queue</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <form asp-action="DisableSchedule" method="post">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDisableScheduleModal">
            Disable Schedule
        </button>
        <div class="modal fade" id="confirmDisableScheduleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Disable Scheduled Runs</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        This will unregister local Windows scheduled tasks for ETL. Continue?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Disable</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <form asp-action="EnableSchedule" method="post">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#confirmEnableScheduleModal">
            Enable Schedule
        </button>
        <div class="modal fade" id="confirmEnableScheduleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Enable Scheduled Runs</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        This will register local Windows scheduled tasks for ETL. Continue?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Enable</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Recent ETL Admin Actions</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Status</th>
                        <th>Started</th>
                        <th>Finished</th>
                        <th>Requested By</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentActions.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-muted">No admin actions have been recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var action in Model.RecentActions)
                        {
                            <tr>
                                <td>@action.ActionType</td>
                                <td>@action.Status</td>
                                <td>@action.StartedAt.LocalDateTime.ToString("g")</td>
                                <td>@(action.FinishedAt?.LocalDateTime.ToString("g") ?? "-")</td>
                                <td>@action.RequestedByUserId</td>
                                <td class="text-wrap">@action.Message</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
