@model RentWisePro.Web.Models.Account.EmailConfirmationPendingViewModel
@{
    ViewData["Title"] = "Confirm your email";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">Check your email</h1>
                    <p class="text-muted mb-3">
                        We sent a confirmation link to <strong>@Model.Email</strong>. Please confirm your email to finish registration.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.ConfirmationLink))
                    {
                        <div class="alert alert-warning">
                            <div class="fw-semibold">Development only</div>
                            <p class="mb-2">Use this confirmation link to activate your account:</p>
                            <a href="@Model.ConfirmationLink">@Model.ConfirmationLink</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            If you don't see the email within a few minutes, please check your spam folder.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
