@model RentWisePro.Web.Models.SavedAnalyses.SavedAnalysisDetailsVm

@{
    ViewData["Title"] = "Saved Analysis";
    ViewData["PageSubtitle"] = Model.LocationLine;
    ViewData["PageMeta"] = Model.ScenarioInvestmentProfileName;
}

@await Html.PartialAsync("_PageHeader")

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-primary" asp-controller="Home" asp-action="GeneratePurchaseSheet" asp-route-savedPropertyProfileId="@Model.SavedPropertyProfileId">
        View Purchase Sheet
    </a>
    <a class="btn btn-outline-primary" asp-controller="SavedAnalyses" asp-action="Forecast" asp-route-id="@Model.SavedPropertyProfileId">
        View ROI Forecast
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-1">@Model.AddressLine</h5>
        <p class="text-muted mb-3">@Model.LocationLine</p>
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small">Purchase Price</div>
                <div class="fw-semibold">@(Model.Price.HasValue ? Model.Price.Value.ToString("C0") : "—")</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small">Saved</div>
                <div class="fw-semibold">@Model.SavedAtUtc.ToLocalTime().ToString("f")</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small">Snapshot Profile</div>
                <div class="fw-semibold">@Model.SnapshotInvestmentProfileName</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small">Scenario Profile</div>
                <div class="fw-semibold">@Model.ScenarioInvestmentProfileName</div>
            </div>
        </div>
        <div class="mt-3">
            <form class="row g-2 align-items-end" method="get" asp-controller="SavedAnalyses" asp-action="Details" asp-route-id="@Model.SavedPropertyProfileId">
                <div class="col-12 col-md-6 col-lg-4">
                    <label for="profileId" class="form-label mb-1">What-if investment profile</label>
                    <select class="form-select" id="profileId" name="profileId">
                        @foreach (var profile in Model.ScenarioProfiles)
                        {
                            var suffix = profile.IsDefault ? " (Default)" : string.Empty;
                            <option value="@profile.Id" selected="@(profile.Id == Model.ScenarioInvestmentProfileId ? "selected" : null)">
                                @($"{profile.Name}{suffix}")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-outline-primary" type="submit">Update scenario</button>
                </div>
                <div class="col-12">
                    <small class="text-muted">
                        Scenario changes recalculate totals without overwriting your saved snapshot.
                    </small>
                    @if (Model.IsScenarioProfileDifferent)
                    {
                        <span class="badge text-bg-info ms-2">What-if view</span>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Snapshot assumptions</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    <tr>
                        <th scope="row">Down payment</th>
                        <td>@Model.Assumptions.DownpaymentPercentage.ToString("0.##")%</td>
                    </tr>
                    <tr>
                        <th scope="row">Interest rate</th>
                        <td>@Model.Assumptions.MortgageInterestRate.ToString("0.##")%</td>
                    </tr>
                    <tr>
                        <th scope="row">Loan term</th>
                        <td>@Model.Assumptions.TermYears yrs</td>
                    </tr>
                    <tr>
                        <th scope="row">Closing cost override</th>
                        <td>@(Model.Assumptions.ClosingCostOverride.HasValue ? Model.Assumptions.ClosingCostOverride.Value.ToString("C0") : "—")</td>
                    </tr>
                    <tr>
                        <th scope="row">Renovation budget</th>
                        <td>@(Model.Assumptions.RenovationBudget.HasValue ? Model.Assumptions.RenovationBudget.Value.ToString("C0") : "—")</td>
                    </tr>
                    <tr>
                        <th scope="row">Other upfront costs</th>
                        <td>@(Model.Assumptions.OtherUpfrontCosts.HasValue ? Model.Assumptions.OtherUpfrontCosts.Value.ToString("C0") : "—")</td>
                    </tr>
                    <tr>
                        <th scope="row">Monthly rent override</th>
                        <td>@(Model.Assumptions.MonthlyRentOverride.HasValue ? Model.Assumptions.MonthlyRentOverride.Value.ToString("C0") : "—")</td>
                    </tr>
                    <tr>
                        <th scope="row">Monthly other expenses override</th>
                        <td>@(Model.Assumptions.MonthlyOtherExpensesOverride.HasValue ? Model.Assumptions.MonthlyOtherExpensesOverride.Value.ToString("C0") : "—")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h5 class="card-title mb-0">Closing Disclosure Summary</h5>
            @if (Model.ClosingDisclosure.ClosingCosts.ClosingCostOverrideApplied)
            {
                <span class="badge text-bg-warning">Closing cost override applied</span>
            }
        </div>
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="border rounded-3 p-3 h-100">
                    <h6 class="fw-semibold">Loan Terms &amp; Monthly Payment</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row">Loan amount</th>
                                    <td>@Model.ClosingDisclosure.LoanTerms.LoanAmount.ToString("C0")</td>
                                </tr>
                                <tr>
                                    <th scope="row">Down payment</th>
                                    <td>@Model.ClosingDisclosure.LoanTerms.DownPaymentAmount.ToString("C0") (@Model.ClosingDisclosure.LoanTerms.DownPaymentPercentage.ToString("0.##")%)</td>
                                </tr>
                                <tr>
                                    <th scope="row">Interest rate</th>
                                    <td>@Model.ClosingDisclosure.LoanTerms.InterestRate.ToString("0.##")%</td>
                                </tr>
                                <tr>
                                    <th scope="row">Loan term</th>
                                    <td>@Model.ClosingDisclosure.LoanTerms.TermYears yrs</td>
                                </tr>
                                <tr>
                                    <th scope="row">Monthly P&amp;I</th>
                                    <td>@Model.ClosingDisclosure.LoanTerms.MonthlyPrincipalAndInterest.ToString("C0")</td>
                                </tr>
                                <tr>
                                    <th scope="row">Monthly escrow</th>
                                    <td>@Model.ClosingDisclosure.LoanTerms.MonthlyEscrow.ToString("C0")</td>
                                </tr>
                                <tr>
                                    <th scope="row">Total monthly payment</th>
                                    <td class="fw-semibold">@Model.ClosingDisclosure.LoanTerms.TotalMonthlyPayment.ToString("C0")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="text-muted small mt-2">@Model.ClosingDisclosure.LoanTerms.MonthlyEscrowNote</div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-primary h-100">
                    <div class="card-body">
                        <h6 class="fw-semibold">Cash to Close</h6>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <th scope="row">Down payment</th>
                                        <td>@Model.ClosingDisclosure.CashToClose.DownPaymentAmount.ToString("C0") (@Model.ClosingDisclosure.CashToClose.DownPaymentPercentage.ToString("0.##")%)</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Closing costs</th>
                                        <td>@Model.ClosingDisclosure.CashToClose.ClosingCostsTotal.ToString("C0")</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Credits/adjustments</th>
                                        <td>@Model.ClosingDisclosure.CashToClose.CreditsAndAdjustments.ToString("C0")</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Other upfront costs</th>
                                        <td>@Model.ClosingDisclosure.CashToClose.OtherUpfrontCosts.ToString("C0")</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Total cash to close</th>
                                        <td class="fw-semibold">@Model.ClosingDisclosure.CashToClose.TotalCashToClose.ToString("C0")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <h6 class="fw-semibold">Closing Costs Breakdown</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var category in Model.ClosingDisclosure.ClosingCosts.Categories)
                        {
                            <tr class="table-light">
                                <th scope="row">@category.Name</th>
                                <td class="text-end fw-semibold">@category.Total.ToString("C0")</td>
                            </tr>
                            foreach (var item in category.LineItems)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">
                                        @item.Label
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <span class="text-muted">(@item.Note)</span>
                                        }
                                    </td>
                                    <td class="text-end">@item.Amount.ToString("C0")</td>
                                </tr>
                            }
                        }
                        <tr class="table-secondary">
                            <th scope="row">Total Closing Costs Used</th>
                            <td class="text-end fw-semibold">@Model.ClosingDisclosure.ClosingCosts.TotalClosingCosts.ToString("C0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @if (Model.ClosingDisclosure.ClosingCosts.ClosingCostOverrideApplied && Model.ClosingDisclosure.ClosingCosts.ClosingCostOverride.HasValue)
            {
                <div class="text-muted small mt-2">
                    Override applied: @Model.ClosingDisclosure.ClosingCosts.ClosingCostOverride.Value.ToString("C0") used instead of the estimated total.
                </div>
            }
        </div>
    </div>
</div>
