<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentWisePro.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentWisePro.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentSavedPropertyProfileId = ViewData["CurrentSavedPropertyProfileId"]?.ToString();
        var hasSavedPropertyProfile = !string.IsNullOrWhiteSpace(currentSavedPropertyProfileId);
        var purchaseSheetUrl = hasSavedPropertyProfile
            ? Url.Action("GeneratePurchaseSheet", "Home", new { savedPropertyProfileId = currentSavedPropertyProfileId })
            : Url.Action("Index", "Home");
        var forecastUrl = hasSavedPropertyProfile
            ? Url.Action("Forecast", "SavedAnalyses", new { id = currentSavedPropertyProfileId })
            : Url.Action("Index", "Home");

        string NavClass(string controller, string action)
        {
            return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
                   && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
        }
    }
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="Primary">
            <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">RentWise Pro</a>
            <nav class="app-nav nav flex-column" role="navigation">
                <a class="nav-link @NavClass("RentalListings", "Index")" asp-controller="RentalListings" asp-action="Index">
                    Listings
                </a>
                <a class="nav-link @NavClass("InvestmentProfiles", "Index")" asp-controller="InvestmentProfiles" asp-action="Index">
                    Investment Profile
                </a>
                @if (hasSavedPropertyProfile)
                {
                    <a class="nav-link @NavClass("Home", "GeneratePurchaseSheet")" href="@purchaseSheetUrl">
                        Purchase Sheet
                    </a>
                    <a class="nav-link @NavClass("SavedAnalyses", "Forecast")" href="@forecastUrl">
                        ROI Forecast
                    </a>
                }
                <a class="nav-link @NavClass("SavedAnalyses", "Index")" asp-controller="SavedAnalyses" asp-action="Index">
                    Saved Analyses
                </a>
                <a class="nav-link @NavClass("Home", "Privacy")" asp-controller="Home" asp-action="Privacy">
                    Privacy
                </a>
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-lg-none" type="button" data-sidebar-toggle aria-label="Toggle navigation">
                        Menu
                    </button>
                    <div class="topbar-title">Investment Dashboard</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-soft">Portfolio Healthy</span>
                    <a class="btn btn-primary btn-sm" asp-controller="RentalListings" asp-action="Index">New Analysis</a>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="user-chip">
                            <span class="user-email">@User.Identity?.Name</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer border-top">
                &copy; 2026 - RentWisePro.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
